{
  "extends": "./tsconfig.app.json",

  // Unit tests for app code. Tests for the data scripts are covered by tsconfig.node.json.
  "include": ["src/**/*.test.ts", "env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    // Tests run in Node.js, not in the browser.
    "lib": [],
    "types": ["node"],

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
